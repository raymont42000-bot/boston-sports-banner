body{

background:#111;

margin:0;

font-family:Arial,Helvetica,sans-serif;

color:white;

}

.container{

padding:25px;

}

.header{

display:flex;

align-items:center;

gap:20px;

}

.logo{

width:70px;

}

.scoreCard{

display:flex;

justify-content:space-between;

align-items:center;

background:#1d1d1d;

padding:30px;

margin-top:25px;

border-radius:18px;

}

.team{

width:180px;

text-align:center;

font-size:24px;

}

.teamLogo{

width:90px;

height:90px;

}

.middle{

text-align:center;

}

#score{

font-size:70px;

font-weight:bold;

}

#inning{

font-size:26px;

color:#9fd8ff;

margin-top:10px;

}

.games{

margin-top:30px;

background:#1d1d1d;

padding:25px;

border-radius:18px;

}

.games h2{

margin-top:0;

}

#schedule div{

padding:10px 0;

border-bottom:1px solid #333;

font-size:24px;

}
