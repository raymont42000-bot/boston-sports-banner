<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Red Sox Dashboard</title>

<link rel="stylesheet" href="style.css">

</head>

<body>

<div class="container">

    <div class="header">
        <img class="logo" src="https://www.mlbstatic.com/team-logos/111.svg">
        <div>
            <h1>Boston Red Sox</h1>
            <div id="status">Loading...</div>
        </div>
    </div>

    <div class="scoreCard">

        <div class="team">

            <img id="awayLogo" class="teamLogo">

            <div id="awayName">Away</div>

        </div>

        <div class="middle">

            <div id="score">-- --</div>

            <div id="inning">Waiting for game...</div>

        </div>

        <div class="team">

            <img class="teamLogo"
                 src="https://www.mlbstatic.com/team-logos/111.svg">

            <div>Red Sox</div>

        </div>

    </div>

    <div class="games">

        <h2>Next Games</h2>

        <div id="schedule"></div>

    </div>

</div>

<script src="script.js"></script>

</body>
</html>
